<Project Sdk="Microsoft.NET.Sdk">

  <ItemGroup>
    <ProjectReference Include="..\Ecad2.Core\Ecad2.Core.csproj" />
    <ProjectReference Include="..\Ecad2.Rendering.Wpf\Ecad2.Rendering.Wpf.csproj" />
    <ProjectReference Include="..\Ecad2.Pdf\Ecad2.Pdf.csproj" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="Dirkster.AvalonDock" Version="4.74.1" />
    <PackageReference Include="Dirkster.AvalonDock.Themes.VS2013" Version="4.74.1" />
  </ItemGroup>

  <!-- T-077増分4(家老采配2026-07-21): 「使い方」ウィンドウの参照先をdocs/spec原文(開発者向け)から
       docs/usage平易版(隠密作成、ユーザー向け)へ切替(単一の真実源を保つ方針は継続、docs/usage更新が
       再ビルドで自動反映される)。docs/spec側の埋め込みは表示に使わなくなったため除去。 -->
  <ItemGroup>
    <EmbeddedResource Include="..\..\docs\usage\ecad2-usage-sheet-document.md">
      <LogicalName>Ecad2.App.UsageContent.ecad2-usage-sheet-document.md</LogicalName>
    </EmbeddedResource>
    <EmbeddedResource Include="..\..\docs\usage\ecad2-usage-menu-toolbar.md">
      <LogicalName>Ecad2.App.UsageContent.ecad2-usage-menu-toolbar.md</LogicalName>
    </EmbeddedResource>
    <EmbeddedResource Include="..\..\docs\usage\ecad2-usage-placement.md">
      <LogicalName>Ecad2.App.UsageContent.ecad2-usage-placement.md</LogicalName>
    </EmbeddedResource>
    <EmbeddedResource Include="..\..\docs\usage\ecad2-usage-wiring.md">
      <LogicalName>Ecad2.App.UsageContent.ecad2-usage-wiring.md</LogicalName>
    </EmbeddedResource>
    <EmbeddedResource Include="..\..\docs\usage\ecad2-usage-undo-redo.md">
      <LogicalName>Ecad2.App.UsageContent.ecad2-usage-undo-redo.md</LogicalName>
    </EmbeddedResource>
    <EmbeddedResource Include="..\..\docs\usage\ecad2-usage-canvas-display.md">
      <LogicalName>Ecad2.App.UsageContent.ecad2-usage-canvas-display.md</LogicalName>
    </EmbeddedResource>
    <EmbeddedResource Include="..\..\docs\usage\ecad2-usage-part-management.md">
      <LogicalName>Ecad2.App.UsageContent.ecad2-usage-part-management.md</LogicalName>
    </EmbeddedResource>
    <EmbeddedResource Include="..\..\docs\usage\ecad2-usage-device-table.md">
      <LogicalName>Ecad2.App.UsageContent.ecad2-usage-device-table.md</LogicalName>
    </EmbeddedResource>
    <EmbeddedResource Include="..\..\docs\usage\ecad2-usage-statusbar.md">
      <LogicalName>Ecad2.App.UsageContent.ecad2-usage-statusbar.md</LogicalName>
    </EmbeddedResource>
    <EmbeddedResource Include="..\..\docs\usage\ecad2-usage-drc-output.md">
      <LogicalName>Ecad2.App.UsageContent.ecad2-usage-drc-output.md</LogicalName>
    </EmbeddedResource>
    <EmbeddedResource Include="..\..\docs\usage\ecad2-usage-pdf-testmode.md">
      <LogicalName>Ecad2.App.UsageContent.ecad2-usage-pdf-testmode.md</LogicalName>
    </EmbeddedResource>
  </ItemGroup>

  <!-- 使い方の説明図(殿ご下命2026-10-09＝スクリーンショット＋矢印)。docs/usage/images/ の PNG を
       丸ごと埋め込む。リソース名はファイル名で付ける(UsageWindow.LoadEmbeddedImage がファイル名で引く)。
       絵そのものは tools/usage-screenshots/ のスクリプトが生成する——手で描き足さぬこと
       (画面が変わるたびに再生成するゆえ、手の加筆は次の再生成で消える)。 -->
  <ItemGroup>
    <EmbeddedResource Include="..\..\docs\usage\images\*.png">
      <LogicalName>Ecad2.App.UsageContent.images.%(Filename)%(Extension)</LogicalName>
    </EmbeddedResource>
  </ItemGroup>

  <!-- P-192(殿ご承認2026-09-14、V1.0で実装): 「リリースノート」ウィンドウの中身。使い方と同じく
       docs 側を単一の真実源とし、再ビルドで自動反映される。リリースのたびに docs/release-notes.md の
       先頭へ新しい版の節を足す。 -->
  <ItemGroup>
    <EmbeddedResource Include="..\..\docs\release-notes.md">
      <LogicalName>Ecad2.App.ReleaseNotes.release-notes.md</LogicalName>
    </EmbeddedResource>
  </ItemGroup>

  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net10.0-windows</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <UseWPF>true</UseWPF>
    <Version>1.0.0</Version>
    <!-- P-191(殿ご承認2026-09-14、V1.0で実装): 著作権表記。年は固定(殿ご裁可＝2026)。
         バージョン情報ダイアログが AssemblyCopyrightAttribute から読んで表示する。exe のプロパティ
         (詳細タブの「著作権」)にも同じ文言が出る。 -->
    <Copyright>Copyright © 2026 FK TEQUNO</Copyright>
    <!-- T-123: アプリアイコン。GuiEcadのAppIcon.icoへ「2」を重ねた意匠（殿裁定2026-08-14＝案C）。
         16px〜256pxの7サイズを内蔵し、32px以下は「2」が潰れぬよう別寸法で描いてある。 -->
    <ApplicationIcon>Assets\AppIcon.ico</ApplicationIcon>
  </PropertyGroup>

</Project>
