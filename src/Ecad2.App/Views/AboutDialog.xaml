<Window x:Class="Ecad2.App.Views.AboutDialog"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="バージョン情報" Height="155" Width="280"
        WindowStartupLocation="CenterOwner" ResizeMode="NoResize"
        ShowInTaskbar="False"
        Background="{DynamicResource DialogBackgroundBrush}"
        Foreground="{DynamicResource DialogForegroundBrush}">
    <StackPanel Margin="12">
        <TextBlock x:Name="VersionText" Margin="0,0,0,6" FontSize="14" HorizontalAlignment="Center"/>
        <!-- P-191(殿ご承認2026-09-14): 著作権表記を1行。行の追加のみに留める(拡張版Aboutは不採用、殿裁可)。 -->
        <TextBlock x:Name="CopyrightText" Margin="0,0,0,12" FontSize="11" HorizontalAlignment="Center"/>
        <Button Content="OK" Width="70" IsDefault="True" IsCancel="True" HorizontalAlignment="Center" Click="OkButton_Click"/>
    </StackPanel>
</Window>
