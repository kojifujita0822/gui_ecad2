<Window x:Class="Ecad2.App.Views.PartEditorDialog"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="自作パーツ編集" Height="440" Width="420"
        WindowStartupLocation="CenterOwner" ResizeMode="NoResize"
        ShowInTaskbar="False"
        Background="{DynamicResource DialogBackgroundBrush}"
        Foreground="{DynamicResource DialogForegroundBrush}">
    <Grid Margin="12">
        <Grid.RowDefinitions>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <TabControl Grid.Row="0">
            <TabItem Header="プロパティ">
                <StackPanel Margin="8">
                    <TextBlock Text="名前:" Margin="0,0,0,4"/>
                    <TextBox x:Name="NameBox" Margin="0,0,0,12"
                             Background="{DynamicResource InputBackgroundBrush}"
                             Foreground="{DynamicResource InputForegroundBrush}"/>

                    <TextBlock Text="幅(セル、1〜12):" Margin="0,0,0,4"/>
                    <TextBox x:Name="WidthBox" Margin="0,0,0,12"
                             Background="{DynamicResource InputBackgroundBrush}"
                             Foreground="{DynamicResource InputForegroundBrush}"/>

                    <TextBlock Text="高さ(セル、1〜12):" Margin="0,0,0,4"/>
                    <TextBox x:Name="HeightBox" Margin="0,0,0,12"
                             Background="{DynamicResource InputBackgroundBrush}"
                             Foreground="{DynamicResource InputForegroundBrush}"/>

                    <TextBlock Text="役割:" Margin="0,0,0,4"/>
                    <ComboBox x:Name="RoleCombo" Margin="0,0,0,12"
                              Background="{DynamicResource InputBackgroundBrush}"
                              Foreground="{DynamicResource InputForegroundBrush}"/>
                </StackPanel>
            </TabItem>

            <!-- T-068増分2(家老采配・殿裁定=案A2026-07-24): 端子(接続点)編集。リスト形式で仮実装、
                 キャンバス上ドラッグへの正式統合は増分3(形状編集キャンバス本体)で対応する
                 (隠密プラン・段階的積み上げ方針)。GuiEcad原本の自動命名(P1,P2,...)を踏襲しつつ、
                 Name列も編集可能にする(電気的挙動はBoundaryOffset順序のみに依存、PartResolver.cs
                 確認済み、Name編集を許してもNetA/NetB判定には影響しない)。 -->
            <TabItem Header="端子">
                <DockPanel Margin="8">
                    <StackPanel DockPanel.Dock="Bottom" Orientation="Horizontal" Margin="0,8,0,0">
                        <Button Content="追加" Width="70" Click="AddPortButton_Click"/>
                        <Button Content="削除" Width="70" Margin="8,0,0,0" Click="DeletePortButton_Click"/>
                    </StackPanel>
                    <DataGrid x:Name="PortsGrid" AutoGenerateColumns="False"
                              CanUserAddRows="False" CanUserDeleteRows="False"
                              HeadersVisibility="Column" GridLinesVisibility="Horizontal"
                              Background="{DynamicResource InputBackgroundBrush}"
                              Foreground="{DynamicResource InputForegroundBrush}">
                        <DataGrid.Columns>
                            <DataGridTextColumn Header="名前" Binding="{Binding Name}" Width="90"/>
                            <DataGridTextColumn Header="行オフセット" Binding="{Binding RowOffset}" Width="*"/>
                            <DataGridTextColumn Header="境界オフセット" Binding="{Binding BoundaryOffset}" Width="*"/>
                        </DataGrid.Columns>
                    </DataGrid>
                </DockPanel>
            </TabItem>
        </TabControl>

        <TextBlock x:Name="ErrorText" Grid.Row="1" Foreground="Red" TextWrapping="Wrap" Margin="0,8,0,0" Visibility="Collapsed"/>

        <StackPanel Grid.Row="2" Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,8,0,0">
            <Button Content="OK" Width="70" IsDefault="True" Click="OkButton_Click"/>
            <Button Content="キャンセル" Width="70" IsCancel="True" Margin="8,0,0,0"/>
        </StackPanel>
    </Grid>
</Window>
