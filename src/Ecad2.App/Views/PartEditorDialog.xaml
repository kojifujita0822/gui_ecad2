<Window x:Class="Ecad2.App.Views.PartEditorDialog"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="自作パーツ編集" Height="600" Width="800"
        MinHeight="420" MinWidth="640"
        WindowStartupLocation="CenterOwner" ResizeMode="CanResize"
        ShowInTaskbar="False"
        Background="{DynamicResource DialogBackgroundBrush}"
        Foreground="{DynamicResource DialogForegroundBrush}">
    <!--
        T-068増分3-a(家老采配2026-07-25、殿事前裁可に基づく家老仮決定1): タブ構成を廃止し、
        GuiEcad原本(PartEditorWindow.xaml)と同じ単一画面構成へ再設計する。原本のRow0-3との対応:
          Row0 = プロパティ(名前/幅高さ/役割)を常時表示          -> 本ファイルのRow0
          Row1 = 描画ツールバー(9種+Undo/Redo/削除+ズーム)       -> 本ファイルのRow1(増分3-bで中身を実装)
          Row2 = 形状編集キャンバス                              -> 本ファイルのRow2左(増分3-bで中身を実装)
          Row3 = ステータス+保存/閉じるボタン                    -> 本ファイルのRow3(エラー表示)・Row4(ボタン)
        端子(接続点)編集は増分3-cでキャンバス上の接続点ツールへ統合し本リストは廃止する。
        それまでは機能を保つため暫定的にRow2の右列へ残置する(家老采配のDoD4、置き場所は実装判断)。
    -->
    <Grid Margin="12">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <!-- Row0: プロパティ(増分1の実装をタブから移設。コントロールのx:Nameは不変ゆえ
             コードビハインドのバリデーション・保存ロジックはそのまま機能する)。 -->
        <WrapPanel Grid.Row="0" Orientation="Horizontal" Margin="0,0,0,8">
            <TextBlock Text="名前:" VerticalAlignment="Center" Margin="0,0,6,0"/>
            <TextBox x:Name="NameBox" Width="200" VerticalAlignment="Center" Margin="0,0,16,0"
                     Background="{DynamicResource InputBackgroundBrush}"
                     Foreground="{DynamicResource InputForegroundBrush}"/>

            <TextBlock Text="幅(セル、1〜12):" VerticalAlignment="Center" Margin="0,0,6,0"/>
            <TextBox x:Name="WidthBox" Width="48" VerticalAlignment="Center" Margin="0,0,16,0"
                     Background="{DynamicResource InputBackgroundBrush}"
                     Foreground="{DynamicResource InputForegroundBrush}"/>

            <TextBlock Text="高さ(セル、1〜12):" VerticalAlignment="Center" Margin="0,0,6,0"/>
            <TextBox x:Name="HeightBox" Width="48" VerticalAlignment="Center" Margin="0,0,16,0"
                     Background="{DynamicResource InputBackgroundBrush}"
                     Foreground="{DynamicResource InputForegroundBrush}"/>

            <TextBlock Text="役割:" VerticalAlignment="Center" Margin="0,0,6,0"/>
            <ComboBox x:Name="RoleCombo" Width="180" VerticalAlignment="Center"
                      Background="{DynamicResource InputBackgroundBrush}"
                      Foreground="{DynamicResource InputForegroundBrush}"/>
        </WrapPanel>

        <!-- Row1: 形状編集ツールバー(原本Row1相当)。ツール本体は増分3-bで実装するため、
             本増分では行の器のみ確保する。 -->
        <Border Grid.Row="1" Margin="0,0,0,8" Padding="8,6"
                Background="{DynamicResource ToolBarBackgroundBrush}"
                BorderBrush="{DynamicResource DialogBorderBrush}" BorderThickness="1">
            <TextBlock Text="形状編集ツール(実装予定)" VerticalAlignment="Center"
                       Foreground="{DynamicResource ToolBarForegroundBrush}"/>
        </Border>

        <!-- Row2: 左=形状編集キャンバス(原本Row2相当、増分3-bで実装)、右=端子リスト(増分3-cまでの
             暫定残置)。増分3-cでは右列(ColumnDefinition・PortsPanel)を削除すれば足りる構成とする。 -->
        <Grid Grid.Row="2">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="Auto"/>
            </Grid.ColumnDefinitions>

            <Border Grid.Column="0" MinHeight="160"
                    Background="{DynamicResource WorkAreaBackgroundBrush}"
                    BorderBrush="{DynamicResource DialogBorderBrush}" BorderThickness="1">
                <TextBlock Text="形状編集キャンバス(実装予定)"
                           HorizontalAlignment="Center" VerticalAlignment="Center"
                           Foreground="{DynamicResource DialogForegroundBrush}"/>
            </Border>

            <DockPanel x:Name="PortsPanel" Grid.Column="1" Width="290" Margin="8,0,0,0">
                <TextBlock DockPanel.Dock="Top" Text="端子" Margin="0,0,0,4"/>
                <StackPanel DockPanel.Dock="Bottom" Orientation="Horizontal" Margin="0,8,0,0">
                    <Button Content="追加" Width="70" Click="AddPortButton_Click"/>
                    <Button Content="削除" Width="70" Margin="8,0,0,0" Click="DeletePortButton_Click"/>
                </StackPanel>
                <DataGrid x:Name="PortsGrid" AutoGenerateColumns="False"
                          CanUserAddRows="False" CanUserDeleteRows="False"
                          HeadersVisibility="Column" GridLinesVisibility="Horizontal"
                          Background="{DynamicResource InputBackgroundBrush}"
                          Foreground="{DynamicResource InputForegroundBrush}">
                    <DataGrid.Columns>
                        <DataGridTextColumn Header="名前" Binding="{Binding Name}" Width="90"/>
                        <DataGridTextColumn Header="行オフセット" Binding="{Binding RowOffset}" Width="*"/>
                        <DataGridTextColumn Header="境界オフセット" Binding="{Binding BoundaryOffset}" Width="*"/>
                    </DataGrid.Columns>
                </DataGrid>
            </DockPanel>
        </Grid>

        <TextBlock x:Name="ErrorText" Grid.Row="3" Foreground="Red" TextWrapping="Wrap" Margin="0,8,0,0" Visibility="Collapsed"/>

        <StackPanel Grid.Row="4" Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,8,0,0">
            <Button Content="OK" Width="70" IsDefault="True" Click="OkButton_Click"/>
            <Button Content="キャンセル" Width="70" IsCancel="True" Margin="8,0,0,0"/>
        </StackPanel>
    </Grid>
</Window>
