<Window x:Class="Ecad2.App.Views.PartTextInputDialog"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="文字の入力" Height="150" Width="320"
        WindowStartupLocation="CenterOwner" ResizeMode="NoResize"
        ShowInTaskbar="False"
        Background="{DynamicResource DialogBackgroundBrush}"
        Foreground="{DynamicResource DialogForegroundBrush}">
    <!--
        T-068増分3-b3: 形状編集キャンバスの文字ツールで配置する文字列を入力する最小モーダル。
        GuiEcad原本(PartEditorWindow.xaml.cs)はその場でContentDialogを組み立てていたが、WPFでは
        Windowの動的組み立てが煩雑でテーマ適用も手間ゆえ、RenameDialog/AddSheetDialogと同型の
        専用ダイアログとして持つ。文字の大きさを変えるUIは設けない(殿裁定=GuiEcad踏襲、
        PartText.SizeCellsは既定値0.25固定)。
    -->
    <Grid Margin="12">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <TextBlock Grid.Row="0" Text="配置する文字:" Margin="0,0,0,4"/>

        <TextBox x:Name="TextBox" Grid.Row="1"
                 Background="{DynamicResource InputBackgroundBrush}"
                 Foreground="{DynamicResource InputForegroundBrush}"/>

        <StackPanel Grid.Row="2" Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,12,0,0">
            <Button Content="OK" Width="70" IsDefault="True" Click="OkButton_Click"/>
            <Button Content="キャンセル" Width="70" IsCancel="True" Margin="8,0,0,0"/>
        </StackPanel>
    </Grid>
</Window>
