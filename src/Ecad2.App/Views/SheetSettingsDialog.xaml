<Window x:Class="Ecad2.App.Views.SheetSettingsDialog"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="シート設定" Height="390" Width="320"
        WindowStartupLocation="CenterOwner" ResizeMode="NoResize"
        ShowInTaskbar="False"
        Background="{DynamicResource DialogBackgroundBrush}"
        Foreground="{DynamicResource DialogForegroundBrush}">
    <!-- T-132増分3: 並び順は殿ご裁定の案ア＝行数 → 列数 → 左母線名 → 右母線名 → 電源ラベル。
         寸法(行・列)が隣り合い、名前類(母線名・電源ラベル)が隣り合う形。
         既存の先頭「行数」を動かさぬため、殿の手が覚えておられる操作を壊さない。
         初期フォーカスも現状どおり RowsBox のまま(xaml.cs の Loaded)。
         Height は両方のエラー行が同時に出ても収まる寸法(元 270 に列数の欄とエラー行、
         電源ラベルの欄を足したもの)。 -->
    <StackPanel Margin="12">
        <TextBlock Text="行数(1〜60):" Margin="0,0,0,4"/>
        <TextBox x:Name="RowsBox" Margin="0,0,0,4"
                 Background="{DynamicResource InputBackgroundBrush}"
                 Foreground="{DynamicResource InputForegroundBrush}"/>
        <TextBlock x:Name="RowsErrorText" Text="1〜60の範囲で入力してください" Foreground="Red"
                   Visibility="Collapsed" Margin="0,0,0,8"/>
        <TextBlock Text="列数(2〜40):" Margin="0,0,0,4"/>
        <TextBox x:Name="ColumnsBox" Margin="0,0,0,4"
                 Background="{DynamicResource InputBackgroundBrush}"
                 Foreground="{DynamicResource InputForegroundBrush}"/>
        <TextBlock x:Name="ColumnsErrorText" Text="2〜40の範囲で入力してください" Foreground="Red"
                   Visibility="Collapsed" Margin="0,0,0,8"/>
        <TextBlock Text="左母線名:" Margin="0,0,0,4"/>
        <TextBox x:Name="LeftNameBox" Margin="0,0,0,12"
                 Background="{DynamicResource InputBackgroundBrush}"
                 Foreground="{DynamicResource InputForegroundBrush}"/>
        <TextBlock Text="右母線名:" Margin="0,0,0,4"/>
        <TextBox x:Name="RightNameBox" Margin="0,0,0,12"
                 Background="{DynamicResource InputBackgroundBrush}"
                 Foreground="{DynamicResource InputForegroundBrush}"/>
        <TextBlock Text="電源ラベル:" Margin="0,0,0,4"/>
        <TextBox x:Name="PowerLabelBox" Margin="0,0,0,12"
                 Background="{DynamicResource InputBackgroundBrush}"
                 Foreground="{DynamicResource InputForegroundBrush}"/>
        <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
            <!-- x:Name は「OKを押したときの経路」をテストから発火させるために付す
                 (T-132増分3、xaml.cs の TryApply の注記を参照)。 -->
            <Button x:Name="OkButton" Content="OK" Width="70" IsDefault="True" Click="OkButton_Click"/>
            <Button Content="キャンセル" Width="70" IsCancel="True" Margin="8,0,0,0"/>
        </StackPanel>
    </StackPanel>
</Window>
